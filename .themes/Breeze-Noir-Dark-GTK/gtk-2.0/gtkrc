# Text/base colors
gtk-color-scheme = "text_color:#55ead4\nbase_color:#000000"
# Foreground/background colors
gtk-color-scheme = "fg_color:#55ead4\nbg_color:#000000"
# Selection colors
gtk-color-scheme = "selected_fg_color:#000000\nselected_bg_color:#f3e600"
# Tooltip colors
gtk-color-scheme = "tooltip_fg_color:#55ead4\ntooltip_bg_color:#31363b"
# Window colors
gtk-color-scheme = "wm_color:#31363b\nunfocused_wm_color:#2a2e32"
# Panel colors
gtk-color-scheme = "panel_bg_color:#000000\npanel_fg_color:#55ead4"
# Dark Theme - Text/base colors
gtk-color-scheme = "dark_text_color:#55ead4\ndark_base_color:#000000"
# Dark Theme - Foreground/background colors
gtk-color-scheme = "dark_fg_color:#55ead4\ndark_bg_color:#000000"
gtk-color-scheme = "sidebar_bg:#000000"
gtk-color-scheme = "sidebar_fg:#55ead4"

# Set GTK settings
gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1

# And hand over the control to the theme files
include "main.rc"
include "apps.rc"
include "hacks.rc"
include "hacks-dark.rc"


# App stylings
include "apps/chrome.rc"
include "apps/gimp.rc"
include "apps/libreoffice.rc"
include "apps/terminal.rc"
include "apps/thunar.rc"
include "apps/xfce.rc"
