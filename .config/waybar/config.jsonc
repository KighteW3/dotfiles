{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "hyprland/language",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    /* ===== WORKSPACES ===== */
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    /* ===== WINDOW (CENTERED) ===== */
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },
    /* ===== IDLE (TEXT BASED) ===== */
    "idle_inhibitor": {
        "format": "IDLE",
        "tooltip": true,
        "tooltip-format-activated": "System Awake",
        "tooltip-format-deactivated": "System Sleep Enabled"
    },
    /* ===== NETWORK (IP DISPLAY) ===== */
    "network": {
        "format-wifi": "  {ipaddr}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "  Offline",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "format-alt": "  {essid}"
    },
    /* ===== OTHER MODULES ===== */
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "  {usage}%"
    },
    "memory": {
        "format": "▤ {percentage}%"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },
    "backlight": {
        "format": "󰃠  {percent}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "󰖁 Muted",
        "on-click": "pavucontrol"
    },
    "hyprland/language": {
        "format": "  {short}"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "systemctl poweroff",
        "tooltip": false
    },
    "custom/media": {
        "format": "🎜 {}",
        "return-type": "json",
        "max-length": 30,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2>/dev/null"
    }
}
