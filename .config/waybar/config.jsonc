{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 2,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "group/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "custom/microphone",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "hyprland/language",
        "custom/capslock",
        "battery",
        "clock",
        "privacy",
        "systemd-failed-units",
        "tray",
        "custom/power"
    ],
    /* ===== WORKSPACES ===== */
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    /* ===== WINDOW (CENTERED) ===== */
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },
    /* ===== IDLE (TEXT BASED) ===== */
    "idle_inhibitor": {
        "format": "IDLE",
        "tooltip": true,
        "tooltip-format-activated": "System Awake",
        "tooltip-format-deactivated": "System Sleep Enabled"
    },
    /* ===== NETWORK (IP DISPLAY) ===== */
    "network": {
        "format-wifi": "  {ipaddr}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "  Offline",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "format-alt": "  {essid}"
    },
    /* ===== OTHER MODULES ===== */
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "  {usage}%"
    },
    "memory": {
        "format": "▤ {percentage}%"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },
    "backlight": {
        "format": "󰃠  {percent}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "󰖁 Muted",
        "on-click": "pavucontrol"
    },
    "custom/microphone": {
        "exec": "status=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null) || exit 0; case \"$status\" in *\"[MUTED]\"*) printf '{\"text\":\"󰍭\",\"class\":\"muted\"}\\n' ;; *) printf '{\"text\":\"\",\"class\":\"active\"}\\n' ;; esac",
        "return-type": "json",
        "interval": 1,
        "hide-empty-text": true,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip": false
    },
    "hyprland/language": {
        "format": "  {short}"
    },
    "custom/capslock": {
        "exec": "if hyprctl devices -j 2>/dev/null | jq -e 'any(.keyboards[]?; .capsLock == true)' >/dev/null 2>&1; then printf ''; fi",
        "interval": 0.2,
        "hide-empty-text": true,
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "systemctl poweroff",
        "tooltip": false
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-previous",
            "mpris",
            "custom/media-next"
        ]
    },
    "custom/media-previous": {
        "exec": "playerctl --player=playerctld --follow status 2>/dev/null | while IFS= read -r status; do case \"$status\" in Playing) printf '{\"text\":\"󰒮\",\"class\":\"playing\"}\\n' ;; Paused) printf '{\"text\":\"󰒮\",\"class\":\"paused\"}\\n' ;; *) printf '{\"text\":\"\"}\\n' ;; esac; done; printf '{\"text\":\"\"}\\n'",
        "return-type": "json",
        "restart-interval": 0.25,
        "exec-on-event": false,
        "hide-empty-text": true,
        "on-click": "playerctl --player=playerctld previous",
        "tooltip": false
    },
    "mpris": {
        "player": "playerctld",
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "format-stopped": "{status_icon}",
        "title-len": 20,
        "artist-len": 14,
        "album-len": 0,
        "dynamic-len": 32,
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-importance-order": [
            "title",
            "artist"
        ],
        "status-icons": {
            "playing": "󰏤",
            "paused": "󰐊",
            "stopped": "󰐊"
        },
        "on-click": "playerctl --player=playerctld play-pause",
        "tooltip-format": "{player} ({status})\n{title}\n{artist} - {album}"
    },
    "custom/media-next": {
        "exec": "playerctl --player=playerctld --follow status 2>/dev/null | while IFS= read -r status; do case \"$status\" in Playing) printf '{\"text\":\"󰒭\",\"class\":\"playing\"}\\n' ;; Paused) printf '{\"text\":\"󰒭\",\"class\":\"paused\"}\\n' ;; *) printf '{\"text\":\"\"}\\n' ;; esac; done; printf '{\"text\":\"\"}\\n'",
        "return-type": "json",
        "restart-interval": 0.25,
        "exec-on-event": false,
        "hide-empty-text": true,
        "on-click": "playerctl --player=playerctld next",
        "tooltip": false
    },
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 16,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 20
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 20
            }
        ],
        "ignore-monitor": true
    },
    "systemd-failed-units": {
        "format": "  {nr_failed}",
        "hide-on-ok": true,
        "system": true,
        "user": true
    }
}
